{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "incremental": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/*": ["./src/*"],
      "@halyard/core": ["../../packages/core/src/index.ts"],
      "@halyard/core/*": ["../../packages/core/src/*"],
      "@halyard/db": ["../../packages/db/src/index.ts"],
      "@halyard/render": ["../../packages/render/src/index.ts"],
      "@halyard/ui": ["../../packages/ui/src/index.tsx"],
      "@halyard/ui/studio": ["../../packages/ui/src/studio/index.tsx"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
