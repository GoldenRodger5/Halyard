# ═══════════════════════════════════════════════════════════════════════════
# Halyard — environment
# Build pack §5. Every key listed, never a value.
# Copy to .env.local (web) and .env (worker). Both files are gitignored.
# ═══════════════════════════════════════════════════════════════════════════

# ── WEB (Vercel) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # public anon key, safe in the browser
SUPABASE_SERVICE_ROLE_KEY=               # server-only. Bypasses RLS. Never ship to a client
ANTHROPIC_API_KEY=                       # generation + co-pilot
CRON_SECRET=                             # shared secret for /api/cron/[task]

# Platform OAuth apps (build pack §5). Register all six on day one — reviews are
# wall-clock time you cannot compress (v2 B.2).
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=                             # covers Instagram AND Threads
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_CLIENT_ID=                        # YouTube Data API v3
GOOGLE_CLIENT_SECRET=

OAUTH_REDIRECT_BASE_URL=                 # https://halyard.example.com  (no trailing slash)
TOKEN_ENCRYPTION_KEY=                    # 32 bytes, base64. `openssl rand -base64 32`
SENTRY_DSN=

# ── WORKER (Railway / Fly) ─────────────────────────────────────────────────
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=             # same key as above
# ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                     # the founder's Professional clone (v2 D.2)
REMOTION_LICENSE_KEY=                    # "free-license" while under 4 employees (v2 D.1)
RESEND_API_KEY=
ALERT_EMAIL=
POSTHOG_PROJECT_API_KEY=                 # read only, for attribution (v1 §9)
POSTHOG_HOST=                            # https://us.i.posthog.com
POSTHOG_PROJECT_ID=
RECIPEFIX_MCP_URL=
RECIPEFIX_MCP_TOKEN=
WORKER_ID=                               # unique per container, e.g. worker-1
# SENTRY_DSN=

# ── LOCAL DEV / CI ONLY ────────────────────────────────────────────────────
# Direct Postgres URL used by the migration runner and integration tests.
# Never points at production.
DATABASE_URL=                            # postgres://postgres@localhost:54322/postgres
