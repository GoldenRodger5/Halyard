# ═══════════════════════════════════════════════════════════════════════════
# Halyard — environment
#
# Every variable is listed by NAME ONLY. Never put real secrets in this file.
#
# Web:      .env.local
# Worker:   .env
#
# Both files are gitignored.
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
# WEB — Vercel
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # browser/public anon key
SUPABASE_SERVICE_ROLE_KEY=               # SERVER ONLY — bypasses RLS

# ── Core application ───────────────────────────────────────────────────────
CRON_SECRET=                             # shared secret for /api/cron/[task]
OAUTH_REDIRECT_BASE_URL=                 # https://halyard.example.com
HALYARD_PUBLIC_URL=                      # https://halyard.example.com
TOKEN_ENCRYPTION_KEY=                    # 32 bytes, base64; openssl rand -base64 32

# ── LLM / AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=                       # Claude Opus/Sonnet/Haiku
OPENAI_API_KEY=                          # GPT-5.5 vision + Whisper + LLM fallback
LLM_PROVIDER=                            # optional; anthropic is the intended primary

# ── Platform OAuth applications ────────────────────────────────────────────
# X
X_CLIENT_ID=
X_CLIENT_SECRET=

# Meta — Instagram + Threads
META_APP_ID=
META_APP_SECRET=

# Threads has its own app id and secret, separate from the Meta app above — Meta:
# "use the Threads app ID and its corresponding app secret". Adding the Threads use
# case to a Meta app mints a different id. Left unset, Halyard falls back to the
# Meta credentials and reports on the Accounts card that it has done so. §173.
THREADS_APP_ID=
THREADS_APP_SECRET=

# Instagram API with Instagram Login issues its own app id and secret, separate
# from META_APP_ID above — the same split Threads has. Halyard reads the secret
# when verifying Meta's signed_request on the deauthorize and data-deletion
# callbacks, and accepts META_APP_SECRET too, so an app configured either way
# works. §183.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=

# TikTok
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Pinterest
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=

# Google — YouTube Data API v3
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── Product / analytics ─────────────────────────────────────────────────────
POSTHOG_PROJECT_API_KEY=                 # read-only project API key
POSTHOG_HOST=                            # e.g. https://us.i.posthog.com
POSTHOG_PROJECT_ID=

# ── RecipeFix integration ──────────────────────────────────────────────────
RECIPEFIX_MCP_URL=
RECIPEFIX_MCP_TOKEN=
RECIPEFIX_WEB_URL=                       # https://recipefix.app

# ── Explorer ────────────────────────────────────────────────────────────────
EXPLORE_ACCOUNT_EMAIL=
EXPLORE_ACCOUNT_PASSWORD=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
NEWSLETTER_FROM=                          # e.g. Halyard <hello@example.com>

# ── App Store Connect attribution ───────────────────────────────────────────
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=                    # escaped newlines if required
APP_STORE_APP_ID=


# ═══════════════════════════════════════════════════════════════════════════
# WORKER — Railway / Fly
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=               # same server-only key as web

# ── LLM / AI ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
LLM_PROVIDER=                            # optional; anthropic is intended primary

# ── ElevenLabs ──────────────────────────────────────────────────────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                     # founder's selected/professional voice

# Music is the ElevenLabs music_v1 capability.
# Only enable after confirming the account/license permits the intended use.
ELEVENLABS_MUSIC_LICENSED=

# ── Rendering / media ──────────────────────────────────────────────────────
REMOTION_LICENSE_KEY=                    # free-license while within applicable limits

# ── Scheduled jobs / worker identity ───────────────────────────────────────
WORKER_ID=                               # e.g. worker-1

# ── App Store attribution ──────────────────────────────────────────────────
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=
APP_STORE_APP_ID=

# ── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=
NEWSLETTER_FROM=

# ── Monitoring ──────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── RecipeFix integration ──────────────────────────────────────────────────
RECIPEFIX_MCP_URL=
RECIPEFIX_MCP_TOKEN=
RECIPEFIX_WEB_URL=

# ── Product analytics ───────────────────────────────────────────────────────
POSTHOG_PROJECT_API_KEY=
POSTHOG_HOST=
POSTHOG_PROJECT_ID=

# ── Explorer ────────────────────────────────────────────────────────────────
EXPLORE_ACCOUNT_EMAIL=
EXPLORE_ACCOUNT_PASSWORD=

# ── Worker tuning / local paths ─────────────────────────────────────────────
# PG_POOL_MAX=8
# RENDER_CONCURRENCY=2
# WHISPER_MODEL_PATH=/opt/models/ggml-base.en.bin
# HALYARD_LIVENESS_FILE=/tmp/halyard-worker-alive
# HALYARD_CAPTURE_DIR=
# HALYARD_LOCAL_ASSET_DIR=


# ═══════════════════════════════════════════════════════════════════════════
# LOCAL DEVELOPMENT / CI ONLY
# ═══════════════════════════════════════════════════════════════════════════

# Direct Postgres connection for migrations/integration tests.
# NEVER point this at production.
DATABASE_URL=                            # postgres://postgres@localhost:54322/postgres

# Local-only auth bypass.
# Refused in production.
HALYARD_DEV_UNAUTHENTICATED=

# Existing running server used by test/screenshot harness.
# TEST_DATABASE_URL=
# HALYARD_URL=


# ═══════════════════════════════════════════════════════════════════════════
# OPTIONAL / DEPLOYMENT-PROVIDED
# ═══════════════════════════════════════════════════════════════════════════

# Build provenance — normally injected by deployment.
# HALYARD_RELEASE=
# HALYARD_BRANCH=
# HALYARD_BUILT_AT=

# Unified publishing transport — optional / currently not required.
# BLOTATO_API_KEY=

# Explicit public origin override, only when request-derived origin cannot
# be trusted. Never use localhost for production profile links.
# PUBLIC_APP_URL=
# Which product the audio fixture seeder attaches test beds to. §241.
# Only read by scripts/seed-audio-fixtures.ts, which creates clearly marked
# TEST audio -- provenance='test', refused by the publish path.
FIXTURE_PRODUCT_ID=recipefix

# Which commit the worker is running, recorded on every heartbeat. §243.
# Railway and Vercel set their own (RAILWAY_GIT_COMMIT_SHA /
# VERCEL_GIT_COMMIT_SHA); GIT_COMMIT_SHA is the manual fallback for a CLI
# deploy, which carries no git metadata. Unset locally is correct -- the
# heartbeat records "unknown" rather than a version that means nothing.
GIT_COMMIT_SHA=
RAILWAY_GIT_COMMIT_SHA=

# Which product imported music attaches to. §248. Read only by
# scripts/import-music.ts.
MUSIC_PRODUCT_ID=recipefix

# §478. Real motion. Licensed portrait b-roll of a beat's subject, under the
# line, where the screenplay asks for footage. Free key at pexels.com/api; the
# licence permits commercial use without attribution. Without it every video is
# stills with a slow push, which is what it was.
PEXELS_API_KEY=

# §494. Cost controls. Images default to medium quality (a quarter of high,
# indistinguishable in a 9:16 frame); a photograph of a subject is reused for
# this many days before another is bought; the voice is billed in plan credits,
# so the ledger estimates USD per thousand characters from your plan.
IMAGE_QUALITY=
HALYARD_PHOTO_REUSE_DAYS=
ELEVENLABS_USD_PER_1K_CHARS=

# §532. Which environment owns the OAuth tokens.
#
# X keeps ONE token chain per (user, developer app). If the same account is
# connected from a laptop and from production through the same X_CLIENT_ID,
# a refresh in either one rotates the chain and silently kills the other's
# stored refresh token — whichever ran last wins, and the loser is told to
# reconnect. That is not a bug you can lock your way out of: the two
# refreshers are in different databases and cannot see each other.
#
# Set this to `off` on any machine that is NOT the one whose tokens are real.
# Leave it unset in production.
HALYARD_TOKEN_REFRESH=

# §551. Which product a sound-effect import belongs to.
#
# Left unset, cues import as `product_id = null` — available to every product,
# which is right for a CC0 effect nobody commissioned. Set it only for a cue
# genuinely made for one product. §548 is the same variable for music.
SFX_PRODUCT_ID=

# §538b. Where whisper.cpp's model lives.
#
# The Docker image has one at /opt/models/ggml-base.en.bin and a developer
# machine does not, so every voiceover on a native worker died on `whisper-cli`
# after three attempts and the render behind it never queued.
WHISPER_MODEL_PATH=

# ── H0: release truth and verification ───────────────────────────────────────

# §564. Make a database-backed suite fail rather than skip.
#
# Forty-three suites guard on `databaseAvailable()` and report GREEN when it is
# false, so "the database half of the suite passed" and "the database half did
# not run" looked identical. §395 found the worse version: connection
# exhaustion also lands there, so a suite that could not get a connection went
# dark rather than red. Set to 1 wherever a green result is believed — CI does,
# and so does `pnpm verify`. Leave unset on a checkout with no Postgres.
HALYARD_REQUIRE_DB=

# §565. Let a test reach the network.
#
# Ordinary test runs refuse every non-local `fetch`, because gotcha 12 tells
# you to source a file full of live billable credentials before running them —
# and four tests in generate.test.ts were buying a real OpenAI generation on
# every full run as a result. Set to 1 only for a deliberate live check.
HALYARD_TEST_ALLOW_NETWORK=

# §567. Which deployment this is, when the platform does not say.
#
# The commit and build time come from `HALYARD_RELEASE` / `HALYARD_BUILT_AT`,
# which `apps/web/next.config.ts` has baked at build time since §174, and from
# RAILWAY_GIT_COMMIT_SHA on the worker. Neither needs setting here.
#
# HALYARD_ENV names the deployment (production/preview/development) when neither
# VERCEL_ENV nor RAILWAY_ENVIRONMENT_NAME is present. An unrecognised value
# reads as `unknown`, never as production — the riskiest state is not a default.
HALYARD_ENV=
