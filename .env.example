# Halyard environment template.
#
# Copy this to `.env` at the repo root, fill it in, then run:
#
#     ./scripts/env-sync
#
# That generates the two files anything actually reads — `apps/web/.env.local`
# for Next and `apps/worker/.env` for the worker container. Editing those
# directly works until the next sync overwrites them, so edit `.env` instead.
#
# Never put a value and a comment on the same line: dotenv reads `KEY=v # note`
# as the literal `v # note`, and Docker's --env-file does not strip it either.

# ═══════════════════════════════════════════════════════════════════════════
# Halyard — environment
# Build pack §5. Every key listed, never a value.
# Copy to .env.local (web) and .env (worker). Both files are gitignored.
# ═══════════════════════════════════════════════════════════════════════════

# ── WEB (Vercel) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=                # https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=           # public anon key, safe in the browser
SUPABASE_SERVICE_ROLE_KEY=               # server-only. Bypasses RLS. Never ship to a client
ANTHROPIC_API_KEY=                       # generation + co-pilot
CRON_SECRET=                             # shared secret for /api/cron/[task]

# Platform OAuth apps (build pack §5). Register all six on day one — reviews are
# wall-clock time you cannot compress (v2 B.2).
X_CLIENT_ID=
X_CLIENT_SECRET=
META_APP_ID=                             # covers Instagram AND Threads
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
GOOGLE_CLIENT_ID=                        # YouTube Data API v3
GOOGLE_CLIENT_SECRET=

OAUTH_REDIRECT_BASE_URL=                 # https://halyard.example.com  (no trailing slash)
TOKEN_ENCRYPTION_KEY=                    # 32 bytes, base64. `openssl rand -base64 32`
SENTRY_DSN=

# ── WORKER (Railway / Fly) ─────────────────────────────────────────────────
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=             # same key as above
# ANTHROPIC_API_KEY=
# Spoken Daily Takes, and nothing else. Whisper transcription so a take can be
# said rather than typed. Entirely optional: with no key the route returns a
# message telling you to type it, and the text field is the primary input.
# OPENAI_API_KEY=
#
# Which provider generates. Anthropic is primary, OpenAI the fallback, and
# whichever key is present is used if this is unset. Set it to pin the choice.
# LLM_PROVIDER=anthropic

ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                     # the founder's Professional clone (v2 D.2)
REMOTION_LICENSE_KEY=                    # "free-license" while under 4 employees (v2 D.1)
RESEND_API_KEY=
# Superseded by settings.alert_email, which the digest reads. Kept only so an
# existing .env.local does not look wrong; nothing reads this variable.
# ALERT_EMAIL=

# ── Referenced by code and previously undocumented ─────────────────────────
#
# Every one of these is read by `process.env` somewhere and was missing here,
# so a fresh clone or a new deployment had no way to know it existed. Found by
# diffing `process.env.X` against this file in both directions.

# Local development only. Bypasses Supabase Auth so the app runs without a
# Supabase project. Refused when NODE_ENV is production, so it cannot be left
# on by accident — but do not leave it set anywhere reachable.
HALYARD_DEV_UNAUTHENTICATED=

# App Store Connect, for install attribution. The private key downloads once
# and cannot be retrieved again. Without these, `collect_attribution` no-ops
# rather than failing, so leaving them blank is safe.
APP_STORE_KEY_ID=
APP_STORE_ISSUER_ID=
APP_STORE_PRIVATE_KEY=                   # -----BEGIN PRIVATE KEY-----\n... (newlines escaped)
APP_STORE_APP_ID=

# Meta webhook. The value is chosen by the operator and must match what is
# entered in the Meta App Dashboard when the callback URL is registered — the
# handshake is refused when it is unset, so the subscription cannot be created
# without it. Activation step, see PLATFORM_COVERAGE §16.
META_WEBHOOK_VERIFY_TOKEN=

# From-address for the daily digest and the newsletter. Both refuse to send
# without it and record the message instead, so leaving it blank is safe.
NEWSLETTER_FROM=                         # RecipeFix <hello@recipefix.app>

# The Explorer signs in to the product as a real user to walk its surfaces.
# Without these the explore job has no account and does nothing.
EXPLORE_ACCOUNT_EMAIL=
EXPLORE_ACCOUNT_PASSWORD=

# The product's own web origin, used by capture flows to drive the real UI.
RECIPEFIX_WEB_URL=                       # https://recipefix.app

# Build provenance, shown on the health screen so an operator can tell which
# commit is running. Set by the deployment, not by hand.
# HALYARD_RELEASE=
# HALYARD_BRANCH=
# HALYARD_BUILT_AT=

# Worker tuning and paths. The container sets these; local runs use defaults.
# PG_POOL_MAX=8
# RENDER_CONCURRENCY=2
# WHISPER_MODEL_PATH=/opt/models/ggml-base.en.bin
# HALYARD_LIVENESS_FILE=/tmp/halyard-worker-alive
# HALYARD_CAPTURE_DIR=
# HALYARD_LOCAL_ASSET_DIR=

# Set only when ElevenLabs music licensing has been confirmed for the account.
# ELEVENLABS_MUSIC_LICENSED=

# Points the test harness and screenshot script at an already-running server.
# TEST_DATABASE_URL=
# HALYARD_URL=
POSTHOG_PROJECT_API_KEY=                 # read only, for attribution (v1 §9)
POSTHOG_HOST=                            # https://us.i.posthog.com
POSTHOG_PROJECT_ID=
RECIPEFIX_MCP_URL=
RECIPEFIX_MCP_TOKEN=
# The origin a stranger uses to reach the app. Only needed where the request's
# own host is not trustworthy; the setup kit derives it from the request first.
# Never localhost: a profile bio pointing at localhost is worse than no link.
# PUBLIC_APP_URL=https://halyard.example.com

# The origin the WORKER builds published links from, written to
# content_items.link_url and sent out in real posts. Required in production:
# generation fails rather than attach a link no reader can open. Local default
# is http://localhost:3200 when NODE_ENV is not production.
HALYARD_PUBLIC_URL=                      # https://halyard.example.com  (no trailing slash)

# Unified publishing transport (milestone 49, optional). Blotato's own app has
# already passed the platform reviews; the key borrows that approval. Buys
# nothing until `pnpm verify-provider` has watched each platform behave.
# BLOTATO_API_KEY=

WORKER_ID=                               # unique per container, e.g. worker-1
# SENTRY_DSN=

# ── LOCAL DEV / CI ONLY ────────────────────────────────────────────────────
# Direct Postgres URL used by the migration runner and integration tests.
# Never points at production.
DATABASE_URL=                            # postgres://postgres@localhost:54322/postgres
