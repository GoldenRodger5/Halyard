#!/usr/bin/env bash
# Halyard environment doctor.
#
#   ./scripts/doctor
#
# Checks everything the app needs and prints the exact command to fix each
# failure. Never changes anything — that is `./scripts/halyard`'s job.

set -uo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

PG_FORMULA="postgresql@17"
DB_NAME="${HALYARD_DB_NAME:-halyard}"
DB_USER="${HALYARD_DB_USER:-$USER}"
PORT="${HALYARD_PORT:-3200}"
ENV_FILE="apps/web/.env.local"
DB_URL="postgres://${DB_USER}@localhost:5432/${DB_NAME}"

for candidate in /opt/homebrew/opt/$PG_FORMULA/bin /usr/local/opt/$PG_FORMULA/bin "$HOME/.orbstack/bin"; do
  [[ -d "$candidate" ]] && export PATH="$candidate:$PATH"
done

FAILURES=0
WARNINGS=0

row() {
  local status="$1" name="$2" detail="$3" fix="$4"
  local mark colour
  case "$status" in
    pass) mark="✓"; colour="32" ;;
    warn) mark="!"; colour="33"; WARNINGS=$((WARNINGS + 1)) ;;
    fail) mark="✗"; colour="31"; FAILURES=$((FAILURES + 1)) ;;
  esac
  printf "\033[${colour}m%s\033[0m  %-26s %s\n" "$mark" "$name" "$detail"
  [[ -n "$fix" && "$status" != "pass" ]] && printf "   %-26s \033[2m%s\033[0m\n" "" "$fix"
  return 0
}

echo ""
printf "\033[1mHalyard doctor\033[0m  —  %s\n\n" "$(date '+%Y-%m-%d %H:%M')"

# ── toolchain ──────────────────────────────────────────────────────────────
if command -v node >/dev/null 2>&1; then
  major="$(node -p 'process.versions.node.split(".")[0]')"
  if [[ "$major" -ge 20 ]]; then
    row pass "node" "$(node -v)" ""
  else
    row fail "node" "$(node -v), need 20 or newer" "brew install node"
  fi
else
  row fail "node" "not installed" "brew install node"
fi

command -v pnpm >/dev/null 2>&1 \
  && row pass "pnpm" "$(pnpm -v)" "" \
  || row fail "pnpm" "not installed" "corepack enable pnpm"

[[ -d node_modules ]] \
  && row pass "dependencies" "installed" "" \
  || row fail "dependencies" "not installed" "pnpm install"

# ── postgres ───────────────────────────────────────────────────────────────
if command -v pg_isready >/dev/null 2>&1; then
  if pg_isready -q -h localhost -p 5432 2>/dev/null; then
    row pass "postgres" "accepting connections on 5432" ""

    if psql -lqt 2>/dev/null | cut -d\| -f1 | grep -qw "$DB_NAME"; then
      row pass "database" "'$DB_NAME' exists" ""

      tables="$(psql "$DB_URL" -tAc \
        "select count(*) from information_schema.tables where table_schema='public'" 2>/dev/null || echo 0)"
      expected="$(ls supabase/migrations/*.sql | wc -l | tr -d ' ')"
      if [[ "$tables" -ge 30 ]]; then
        row pass "migrations" "$tables tables, $expected migration files" ""
      else
        row fail "migrations" "only $tables tables" "./scripts/halyard --reset"
      fi

      items="$(psql "$DB_URL" -tAc 'select count(*) from content_items' 2>/dev/null || echo 0)"
      if [[ "$items" -gt 0 ]]; then
        row pass "seed data" "$items content items" ""
      else
        row warn "seed data" "database is empty" "./scripts/halyard --reset"
      fi

      assets="$(psql "$DB_URL" -tAc \
        "select count(*) from assets where public_url is not null" 2>/dev/null || echo 0)"
      if [[ "$assets" -gt 0 ]]; then
        row pass "rendered assets" "$assets with public urls" ""
      else
        row warn "rendered assets" "queue previews will be empty" "pnpm exec tsx scripts/seed-assets.ts"
      fi
    else
      row fail "database" "'$DB_NAME' does not exist" "createdb $DB_NAME"
    fi
  else
    row fail "postgres" "not accepting connections" "brew services start $PG_FORMULA"
  fi
else
  row fail "postgres" "client not on PATH" "brew install $PG_FORMULA"
fi

# ── env ────────────────────────────────────────────────────────────────────
if [[ -f "$ENV_FILE" ]]; then
  row pass "env file" "$ENV_FILE" ""

  configured="$(grep '^DATABASE_URL=' "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2-)"
  if [[ "$configured" == "$DB_URL" ]]; then
    row pass "DATABASE_URL" "matches this machine" ""
  elif [[ -z "$configured" ]]; then
    row fail "DATABASE_URL" "not set in $ENV_FILE" "./scripts/halyard"
  else
    row fail "DATABASE_URL" "points at $configured" "./scripts/halyard  (repairs it)"
  fi

  # Required for anything that generates, publishes, or speaks.
  for key in ANTHROPIC_API_KEY:"generation and co-pilot" \
             RECIPEFIX_MCP_URL:"live product data" \
             ELEVENLABS_API_KEY:"voiceover" \
             GITHUB_TOKEN:"changelog signals" \
             TOKEN_ENCRYPTION_KEY:"OAuth token sealing" \
             CRON_SECRET:"authenticating the web-side crons"; do
    name="${key%%:*}"; purpose="${key#*:}"
    if grep -qE "^${name}=[[:space:]]*[^[:space:]#]" "$ENV_FILE" 2>/dev/null; then
      row pass "$name" "set" ""
    else
      row warn "$name" "unset — $purpose stays offline" "add ${name}= to $ENV_FILE"
    fi
  done

  # ── X, the only platform that can go live today ─────────────────────────
  #
  # Every other platform is waiting on a manual review measured in weeks. X has
  # no review gate, so it is the one place the whole chain can be proved, and
  # these two variables are the only thing standing between here and that.
  if grep -qE "^X_CLIENT_ID=[[:space:]]*[^[:space:]#]" "$ENV_FILE" 2>/dev/null \
     && grep -qE "^X_CLIENT_SECRET=[[:space:]]*[^[:space:]#]" "$ENV_FILE" 2>/dev/null; then
    row pass "X credentials" "set — first contact is possible" "pnpm first-contact --dry-run"
  else
    row warn "X credentials" "unset — no platform can publish yet" ""
    cat <<'ACQUIRE'

      How to get them, in order. Twenty minutes, most of it waiting on forms.

      1. developer.x.com  →  sign in as the account that will own the app
      2. Subscribe to a paid tier. Free-tier apps cannot post: the token
         exchange succeeds and the first publish returns 403, which is the
         most confusing failure in this whole system.
      3. Projects & Apps  →  create a project, then an app inside it
      4. App  →  User authentication settings  →  Set up
           · App permissions:            Read and write
           · Type of App:                Web App, Automated App or Bot
           · Callback URI:               http://localhost:3200/api/oauth/x/callback
                                         (and your deployed URL, exactly, no trailing slash)
           · Website URL:                https://recipefix.app
      5. Keys and tokens  →  OAuth 2.0 Client ID and Client Secret
           The secret is shown once. Copy it now.
      6. Put both in apps/web/.env.local:
           X_CLIENT_ID=...
           X_CLIENT_SECRET=...
      7. Add a payment method. Posting is billed per call — about $0.015
         without a link, $0.20 with one, which is why Halyard puts the link
         in the first reply.

      Before creating any account:  /setup-kit
      It generates the bios, display names, profile images at each platform's
      exact required size, and the checklist of what must be true before an
      API can publish there. `pnpm check-handle <name>` checks availability.

      Then:  ./scripts/halyard  →  /accounts  →  Connect, for the brand
      account and again for the founder account, each in a private window.
      Then:  pnpm first-contact --dry-run

ACQUIRE
  fi

  # ── the unified transport ───────────────────────────────────────────────
  #
  # Optional by design. Halyard publishes through its own adapters; the unified
  # provider exists to borrow somebody else's already-approved app for the five
  # platforms that gate public posting behind a review measured in weeks.
  #
  # Nothing here is assumed to work. The key alone buys nothing until
  # `pnpm verify-provider` has watched each platform behave.
  if grep -qE "^BLOTATO_API_KEY=[[:space:]]*[^[:space:]#]" "$ENV_FILE" 2>/dev/null; then
    verified="$(psql "$DB_URL" -tAc \
      "select coalesce(to_char(verified_at, 'YYYY-MM-DD'), 'never') from provider_capabilities where provider = 'blotato'" 2>/dev/null || echo '')"
    if [[ -z "$verified" ]]; then
      row warn "Blotato" "key set, never probed" "pnpm verify-provider"
    else
      row pass "Blotato" "verified $verified" "pnpm verify-provider  (re-check)"
    fi
  else
    row warn "BLOTATO_API_KEY" "unset — every platform stays on its own adapter" ""
    cat <<'ACQUIRE'

      Optional. Skip it unless you want the five review-gated platforms
      publishing before their reviews land. X and Bluesky never need it.

      1. blotato.com  →  sign up  →  paid plan, $29/month, your card
         The API is on paid plans only. So is analytics.
      2. Connect the accounts inside Blotato — its OAuth, its approved app.
         That is the entire point: their app already passed the reviews.
      3. Settings  →  API  →  copy the key
      4. Put it in apps/web/.env.local:
           BLOTATO_API_KEY=...
      5. pnpm verify-provider
           Read-only. Lists every connected account with its provider id,
           which is what /accounts asks for when you switch transport.
      6. pnpm verify-provider --publish
           Posts real content to your real accounts, TikTok first and alone,
           to settle the one claim their marketing cannot: whether TikTok
           posts publicly or only to drafts. Delete the test posts after.

      Until step 6 has run for a platform, switching it to the unified
      transport is refused rather than attempted. Unknown is not permission.

ACQUIRE
  fi

  # Sending needs Resend, and the milestone is explicit that it must be the
  # account RecipeFix already uses rather than a second one.
  for key in RESEND_API_KEY:"newsletter sending" \
             APP_STORE_KEY_ID:"App Store attribution and reviews" \
             SENTRY_DSN:"error reporting"; do
    name="${key%%:*}"; purpose="${key#*:}"
    if grep -qE "^${name}=[[:space:]]*[^[:space:]#]" "$ENV_FILE" 2>/dev/null; then
      row pass "$name" "set" ""
    else
      row warn "$name" "unset — $purpose stays offline" "see /settings/readiness"
    fi
  done
else
  row fail "env file" "missing" "cp .env.example $ENV_FILE"
fi

# ── port ───────────────────────────────────────────────────────────────────
if lsof -ti :"$PORT" >/dev/null 2>&1; then
  pid="$(lsof -ti :"$PORT" | head -1)"
  row warn "port $PORT" "in use by pid $pid" "kill $pid  (or ./scripts/halyard frees it)"
else
  row pass "port $PORT" "free" ""
fi

# ── container runtime ──────────────────────────────────────────────────────
if command -v docker >/dev/null 2>&1; then
  if docker info >/dev/null 2>&1; then
    row pass "docker" "$(docker version --format '{{.Server.Version}}' 2>/dev/null)" ""
    if docker ps -q -f name=halyard-worker 2>/dev/null | grep -q .; then
      row pass "worker container" "running" ""
    else
      row warn "worker container" "not running" "./scripts/halyard --worker"
    fi
  else
    row warn "docker" "installed, daemon not running" "open -a OrbStack"
  fi
else
  row warn "docker" "not installed — no rendering or publishing" "brew install orbstack"
fi

# ── worker heartbeat ───────────────────────────────────────────────────────
if pg_isready -q -h localhost -p 5432 2>/dev/null; then
  beat="$(psql "$DB_URL" -tAc \
    "select coalesce(extract(epoch from now() - max(last_seen_at))::int, -1) from worker_heartbeats" 2>/dev/null || echo -1)"
  if [[ "$beat" -lt 0 ]]; then
    row warn "worker heartbeat" "never seen" "./scripts/halyard --worker"
  elif [[ "$beat" -lt 900 ]]; then
    row pass "worker heartbeat" "${beat}s ago" ""
  else
    row fail "worker heartbeat" "${beat}s ago — worker is dead" "docker restart halyard-worker"
  fi
fi

# ── the only things a person has to do ─────────────────────────────────────
#
# Everything else in this file is something a script can fix. These four cannot
# be: they need an identity, a payment card, or a judgement that is the whole
# point of the system.
echo ""
printf "\033[1mWhat only you can do\033[0m\n\n"

need_browser=0
for key in ANTHROPIC_API_KEY:"console.anthropic.com — sign in, create a key, paste it back"; do
  name="${key%%:*}"; what="${key#*:}"
  grep -qE "^${name}=[[:space:]]*[^[:space:]#]" "$ENV_FILE" 2>/dev/null || {
    printf "  \033[33m·\033[0m %-26s %s\n" "$name" "$what"; need_browser=1; }
done

grep -qE '^X_CLIENT_ID=[[:space:]]*[^[:space:]#]' "$ENV_FILE" 2>/dev/null || {
  printf "  \033[33m·\033[0m %-26s %s\n" "X developer app" \
    "developer.x.com — your identity and a card. Full steps printed above"; need_browser=1; }

if pg_isready -q -h localhost -p 5432 2>/dev/null; then
  reviewed="$(psql "$DB_URL" -tAc \
    "select coalesce(max(calibration_reviewed), 0) from onboarding_state" 2>/dev/null || echo 0)"
  target="$(psql "$DB_URL" -tAc \
    "select coalesce(max(calibration_target), 20) from onboarding_state" 2>/dev/null || echo 20)"
  if [[ "${reviewed:-0}" -lt "${target:-20}" ]]; then
    printf "  \033[33m·\033[0m %-26s %s\n" "Calibration" \
      "/onboarding — rate ${target} drafts, ${reviewed} done. This is your taste; nothing can infer it"
    need_browser=1
  fi

  swipes="$(psql "$DB_URL" -tAc "select count(*) from references_swipe" 2>/dev/null || echo 0)"
  if [[ "${swipes:-0}" -lt 15 ]]; then
    printf "  \033[33m·\033[0m %-26s %s\n" "Swipe file" \
      "/swipe — 15 entries, ${swipes} saved. Also your taste"
    need_browser=1
  fi
fi

printf "  \033[33m·\033[0m %-26s %s\n" "Social accounts" \
  "creating the profiles themselves. /setup-kit generates the bios and images first"

[[ $need_browser -eq 0 ]] && printf "  \033[32m✓\033[0m nothing outstanding\n"
echo ""

if [[ $FAILURES -gt 0 ]]; then
  printf "\033[31m%d failing\033[0m, %d warnings\n\n" "$FAILURES" "$WARNINGS"
  exit 1
fi
printf "\033[32mall checks pass\033[0m%s\n\n" "$([[ $WARNINGS -gt 0 ]] && echo ", $WARNINGS warnings")"
