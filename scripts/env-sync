#!/usr/bin/env bash
#
# Generate the two env files anything actually reads, from the master `.env`.
#
# Next reads its own project directory and the worker runs in a container, so
# neither can see a file at the repo root — the master exists so there is one
# place to edit, and this is what makes that true. Editing the generated files
# directly works until the next sync overwrites it.
#
#   .env  →  apps/web/.env.local     (Next.js, pnpm dev, scripts/dev-all.ts)
#         →  apps/worker/.env        (docker run --env-file)
#
# Two differences are applied on the way, and they are the reason this is a
# script rather than a copy:
#
#   · DATABASE_URL is rewritten to host.docker.internal for the worker. A
#     container cannot reach "localhost" — that is the host's own loopback.
#   · The worker file carries only what the worker uses. Docker's --env-file
#     is not dotenv: it does no quote handling and no inline-comment stripping,
#     so the fewer lines in it the better.
#
set -euo pipefail
cd "$(dirname "$0")/.."

MASTER=".env"
WEB="apps/web/.env.local"
WORKER="apps/worker/.env"

[[ -f "$MASTER" ]] || { echo "no $MASTER — copy .env.example and fill it in"; exit 1; }

# Keys the worker container needs. Everything else stays out of its env file.
# §180. Refuse to sync a master file that says two different things.
#
# `.env` carried TIKTOK_CLIENT_KEY twice — once with the real value and once
# empty, left behind by an earlier edit. Shell sourcing keeps the *last*
# assignment, so the empty one won, and both tier files were written with a blank
# credential. The Accounts card then said "Needs developer setup" for a platform
# whose credentials were sitting in the file it had just been generated from.
#
# Nothing failed. That is the problem: an empty value is a value, and every layer
# downstream treated it as a deliberate one.
duplicates="$(grep -oE '^[A-Z_][A-Z0-9_]*=' "$MASTER" | sort | uniq -d | sed 's/=$//')"
if [ -n "$duplicates" ]; then
  echo "refusing to sync: $MASTER assigns these keys more than once, and the last one wins silently:" >&2
  echo "$duplicates" | sed 's/^/  /' >&2
  echo "keep one line per key, then run this again." >&2
  exit 1
fi

# §457 was wrong to add WHISPER_MODEL_PATH here and §462 removes it.
# `docker run --env-file` **overrides** the image's own `ENV`, so exporting the
# host's model path handed the container a file it cannot see and every tts job
# died on it — the same failure the variable was added to fix, moved from the
# native run into the container. The image bakes its own path at /opt/models;
# a native run needs the variable in its own shell and not in this file.
WORKER_KEYS="DATABASE_URL WORKER_ID TOKEN_ENCRYPTION_KEY
ANTHROPIC_API_KEY OPENAI_API_KEY LLM_PROVIDER
ELEVENLABS_API_KEY ELEVENLABS_VOICE_ID ELEVENLABS_MUSIC_LICENSED
X_CLIENT_ID X_CLIENT_SECRET META_APP_ID META_APP_SECRET
THREADS_APP_ID THREADS_APP_SECRET
INSTAGRAM_APP_ID INSTAGRAM_APP_SECRET
HALYARD_OAUTH_SANDBOX TIKTOK_CLIENT_KEY_SANDBOX TIKTOK_CLIENT_SECRET_SANDBOX
TIKTOK_CLIENT_KEY TIKTOK_CLIENT_SECRET PINTEREST_APP_ID PINTEREST_APP_SECRET
GOOGLE_CLIENT_ID GOOGLE_CLIENT_SECRET
HALYARD_PUBLIC_URL BLOTATO_API_KEY
RECIPEFIX_MCP_URL RECIPEFIX_MCP_TOKEN RECIPEFIX_WEB_URL
EXPLORE_ACCOUNT_EMAIL EXPLORE_ACCOUNT_PASSWORD
RESEND_API_KEY NEWSLETTER_FROM
PEXELS_API_KEY
APP_STORE_KEY_ID APP_STORE_ISSUER_ID APP_STORE_PRIVATE_KEY APP_STORE_APP_ID
SENTRY_DSN"

banner() { printf '# Generated by scripts/env-sync from .env — edit the master, not this file.\n# %s\n\n' "$1"; }

# ── web ────────────────────────────────────────────────────────────────────
{
  banner "Read by Next.js. WORKER_ID is omitted; it identifies the worker only."
  # WORKER_ID names the worker only. VERCEL_OIDC_TOKEN is short-lived and
  # written by `vercel env pull` — copying it around just makes a stale one.
  grep -E '^[A-Z][A-Z0-9_]*=' "$MASTER" | grep -vE '^(WORKER_ID|VERCEL_OIDC_TOKEN)='
} > "$WEB"

# ── worker ─────────────────────────────────────────────────────────────────
{
  banner "Read by docker run --env-file. Values only — no inline comments."
  for key in $WORKER_KEYS; do
    line="$(grep -E "^${key}=" "$MASTER" || true)"
    [[ -n "$line" ]] || continue
    if [[ "$key" == "DATABASE_URL" ]]; then
      # A container's "localhost" is the container, not the host.
      echo "${line/localhost/host.docker.internal}"
    else
      echo "$line"
    fi
  done
} > "$WORKER"

printf 'synced  %s (%s keys)  %s (%s keys)\n' \
  "$WEB" "$(grep -cE '^[A-Z]' "$WEB")" "$WORKER" "$(grep -cE '^[A-Z]' "$WORKER")"
