writeFileSync(out+'/render-receipt.json',JSON.stringify({tag,width:1080,height:1920,frames:composition.durationInFrames,fps:30,renderSeconds:(Date.now()-start)/1000,externalGenerationCalls:0,additionalCashUSD:0,audio:'silent edit; voice generation held',scope:product?'Edit of the separately authorized six-second API shot with genuine recorded RecipeFix UI and method pixels; generated planning illustration, not a kitchen test.':'Licensed actual food preparation plus one generated style frame; not an I2V result or a kitchen experiment.'},null,2)+'\n');
console.log(out+'/'+filename);
