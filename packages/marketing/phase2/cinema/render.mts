if(!/^[a-z0-9-]+$/.test(tag))throw Error('Simple unique output tag required');
const out='/Volumes/T9/Developer/Builds/recipefix-phase2-20261029/integration/cinema/'+tag;
if(existsSync(out))throw Error('Preserve prior proof');
mkdirSync(out,{recursive:true});
process.env.TMPDIR='/Volumes/T9/Developer/Builds/recipefix-phase2-20261029/integration/scratch';
const browserExecutable=path.resolve('node_modules/.remotion/chrome-headless-shell/mac-arm64/chrome-headless-shell-mac-arm64/chrome-headless-shell');
if(!existsSync(browserExecutable))throw Error('Reuse installed browser; do not download');
const start=Date.now();
const serveUrl=await bundle({entryPoint:root+'/entry.tsx',publicDir:root+'/assets',outDir:out+'/bundle'});
const product=process.argv.includes('--product');
const composition=await selectComposition({serveUrl,id:product?'BroilerProductProof':'PineappleCinemaProof',browserExecutable});
